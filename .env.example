# Public base URL of the app (used for links, QR codes, cookies and OIDC redirect)
PUBLIC_URL=https://drinks.example.com
PORT=3000

# PostgreSQL connection (standard libpq variables)
PGHOST=localhost
PGPORT=5432
PGUSER=drinktracker
PGPASSWORD=change-me
PGDATABASE=drinktracker

# Key for encrypting and indexing the secret event links (>= 32 random characters)
TOKEN_KEY=change-me-to-a-long-random-string

# Optional: admin login via OpenID Connect (callback: $PUBLIC_URL/admin/callback)
OIDC_ISSUER=https://idp.example.com/application/o/drinktracker/
OIDC_CLIENT_ID=drinktracker
OIDC_CLIENT_SECRET=change-me
SESSION_SECRET=change-me-to-another-long-random-string

# Optional: Pushover notification to the admin when a new event is started
PUSHOVER_TOKEN=
PUSHOVER_USER=
